# Copy to `.env` in the repo root for local development. Never commit real passwords.
#
# Production on Render: DATABASE_URL is set automatically from Render Postgres (see render.yaml at repo root).
#
# Local dev — use either:
#   - Local Postgres:
#       DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/pricing_prototype
#   - Or paste “External Database URL” from your Render Postgres dashboard (same DB as prod).

DATABASE_URL=postgresql+asyncpg://mitalijaiswal@localhost:5432/pricing_prototype

# On Render, RENDER=true is set automatically and Postgres TLS uses relaxed cert verification.

# Optional SSL overrides
# DATABASE_SSL=false
# DATABASE_SSL_NO_VERIFY=true   # force relaxed TLS verification (non-Render hosts)
# DATABASE_SSL_VERIFY=true        # on Render: strict cert verify (default off when RENDER=true)
